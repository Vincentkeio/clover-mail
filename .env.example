# ============================================================
# clover 三叶草邮局 — 环境变量模板
# install.sh 复制本文件为 .env 并按提示替换各参数
# ============================================================

# ---------- 域名 ----------
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com          # 邮件主机名（MX/rDNS 指向它）
PANEL_HOSTNAME=panel.example.com        # 面板域名（Caddy 自动 HTTPS）

# ---------- 证书 / 时区 ----------
ACME_EMAIL=admin@example.com            # Caddy ACME 通知邮箱
TZ=Asia/Shanghai

# ---------- 邮件 TLS 证书（587/465 认证发信必需）----------
# 留空时 install.sh 自动生成自签证书（客户端需允许自签）。
# 可在面板「面板设置 → TLS 证书」为邮件主机签发 Let's Encrypt 证书并自动安装/续期。
# 下列路径由安装器设为 DMS 配置卷内的邮件证书路径：
#   SSL_TYPE=manual
#   SSL_CERT_PATH=/tmp/docker-mailserver/ssl/mail.crt
#   SSL_KEY_PATH=/tmp/docker-mailserver/ssl/mail.key
SSL_TYPE=
SSL_CERT_PATH=
SSL_KEY_PATH=

# ---------- 面板镜像与入口端口 ----------
# 默认跟随 GHCR 最新 Alpha 镜像（amd64）；自建镜像可改这两项
CLOVER_PANEL_IMAGE=ghcr.io/vincentkeio/clover-panel
CLOVER_TAG=latest
# 宿主机已有 Nginx/Caddy 时，安装器会将容器入口绑定到 loopback 高位端口
CLOVER_HTTP_PORT=80
CLOVER_HTTPS_PORT=443
CLOVER_CADDY_HTTP_PUBLISH=80
CLOVER_CADDY_HTTPS_PUBLISH=443
CLOVER_CADDY_SCHEME=https
CLOVER_SHARED_NGINX=0
CLOVER_SHARED_CADDY=0
CLOVER_HOST_CADDY_CONFIG=
CLOVER_HOST_CADDY_BIN=
CLOVER_HOME=/opt/clover
# TLS 模式：留空 = ACME 真证书；测试机可填 tls internal（自签，浏览器会告警）
CLOVER_TLS_DIRECTIVE=

# ---------- docker-mailserver（DMS）----------
# 官方环境变量见 https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
ENABLE_RSPAMD=1                         # 反垃圾（rspamd + redis）
# RSPAMD_LEARN=1                        # 让移入/移出 Junk 的操作训练全局 Bayes；仅在邮箱用户可信时启用
ENABLE_SRS=1                            # 别名向外部邮箱转发时重写 envelope sender，降低转发导致的 SPF 失败
ENABLE_POP3=1                           # POP3/POP3S 服务；端口映射在 compose.yaml，全局邮箱设置控制账号登录
ENABLE_MANAGESIEVE=1                    # ManageSieve 服务（4190）；端口映射在 compose.yaml，全局邮箱设置控制账号登录
# ↑ 这两个 env 只是让 DMS 把监听器准备好；**是否对外服务由面板「设置 → 协议开关」控制**
#   （面板写 dovecot.cf 覆盖 + dovecot reload，秒级生效、无需重建容器）
ENABLE_OPENDKIM=1                       # DKIM 签名（显式开启：与 rspamd 同开时由 OpenDKIM 管密钥，
                                        # DMS 启动会打一条 "both Rspamd and OpenDKIM enabled" 警告，属预期）
ENABLE_CLAMAV=1                         # 防病毒（内存吃紧可关；install.sh 在 <2GB 机器上自动关）
ENABLE_FAIL2BAN=0                       # 需要 NET_ADMIN 能力，M0 关闭
SPOOF_PROTECTION=1                      # 防伪造发件人
LOG_LEVEL=info                          # trace/debug/info/warning/error
TLS_LEVEL=intermediate

# ---------- clover-panel ----------
DATABASE_PATH=/app/data/clover.db
DMS_CONTAINER=docker-mailserver         # docker exec 的目标容器名
ADMIN_BOOTSTRAP_USER=admin
SESSION_SECRET=change-me-to-random-32+  # 面板 session 签名密钥（install.sh 自动生成）
ROUNDCUBE_SSO_SECRET=                  # Roundcube 登录桥接密钥（安装/更新自动生成）
RECONCILE_TOKEN=                        # 对账/备份 cron 的 Bearer token（install.sh 自动生成）
ALLOW_SEED=false                        # 开 true 后 POST /api/dev/seed 灌演示数据（仅本地）
DEMO_MODE=false                         # 开 true 后面板免登录（仅本地预览，生产严禁）

# ---------- 首启预置（install.sh 写入，面板直接读用，免去进设置页手填）----------
CLOVER_VPS_IP=                          # VPS 公网 IP（DNS 生成器的 A / SPF 用）
CLOVER_CF_API_TOKEN=                    # Cloudflare token（Zone.DNS:Edit，可留空后补）
# WebMail 免密登录凭据由面板自动生成并加密管理，无需在此填写。

# ---------- 兼容旧名（M2 起改用 CLOVER_CF_API_TOKEN）----------
CF_API_TOKEN=
